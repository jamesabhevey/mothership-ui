{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "composite": false,
    "incremental": false
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/docs",
    "src/pages",
    "src/foundations",
    "src/assets",
  ]
}
